# dirdiff as the tool for `git difftool --dir-diff'.
#
# Copy this into ~/.gitconfig, or set the same values with
# git config --global.  Your Emacs init must load dirdiff (see
# dirdiff-init.el).  Then:
#
#   git difftool -d HEAD~3         # HEAD~3 vs the working tree
#   git difftool -d A..B           # two commits
#   git dd A..B                    # the same, with the alias below
#
# A new Emacs starts and exits when the comparison is quit; git waits
# for that.  dirdiff compares directories only, so always use -d.

[diff]
	tool = dirdiff
[difftool]
	prompt = false
[difftool "dirdiff"]
	cmd = emacs -f dirdiff-difftool-command-line \"$LOCAL\" \"$REMOTE\"
[alias]
	dd = difftool -d --tool=dirdiff
